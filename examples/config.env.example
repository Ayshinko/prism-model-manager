# Trusted Bash configuration. Copy manually to:
# $HOME/.config/prism-model-manager/config.env
MODEL_ROOT="$HOME/Models"
PRISM_ROOT="$HOME/prism-llama"
# Exact server path, when not under $PRISM_ROOT (optional):
# SERVER_BIN="/path/to/llama-server"
# BENCH_BIN="/path/to/llama-bench"
HOST=127.0.0.1
PORT=8080
CTX=8192
NGL=99
FLASH=on
BATCH=512
UBATCH=512
PARALLEL=1
CACHE_K=f16
CACHE_V=f16
LORA_ENABLED=off
LORA_PATH=""
LORA_SCALE=2

# Speculation is remembered in each model profile through the TUI:
# SPEC_MODE: OFF, MTP, or "Draft Model"; SPEC_DRAFT_TOKENS: 1..8.
# MTP can use an optional draft GGUF; Draft Model mode requires one.
VISION=off
REASONING_BUDGET=-1
