# Trusted Bash configuration. Copy manually to:
# ${XDG_CONFIG_HOME:-$HOME/.config}/prism-model-manager/config.env
MODEL_ROOT="$HOME/Models"
PRISM_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/prism-llama"
# Optional exact paths override discovery:
SERVER_BIN=""
BENCH_BIN=""
HOST=127.0.0.1
PORT=8080
CTX=4096
NGL=99
FLASH=on
BATCH=512
UBATCH=128
PARALLEL=1
CACHE_K=f16
CACHE_V=f16
LORA_ENABLED=off
LORA_PATH=""
LORA_SCALE=2

# Model/runtime capabilities still require a compatible custom backend.
VISION=off
MMPROJ_PATH=""
MTP=off
MTP_MODE=mtp
MTP_DRAFT_MAX=3
# Use --draft-max only when supported by an older custom build.
MTP_DRAFT_FLAG=--spec-draft-n-max
STARTUP_TIMEOUT=180
