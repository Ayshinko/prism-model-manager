# Trusted Bash configuration. Copy manually to:
# ${XDG_CONFIG_HOME:-$HOME/.config}/prism-model-manager/config.env
#
# Recommended values for a ternary PTQ1_0 + embedded-MTP Bonsai model on a 12 GB
# GPU (RTX 4070 SUPER, PR #218 fork build): CTX=40960, CTK=q8_0, CTV=q8_0,
# BATCH=2048, UBATCH=512, NGL=99, MTP=on, MTP_MODE=draft-mtp, MTP_DRAFT_MAX=1.
# Those settings measured ~9.2 GB VRAM and fit with headroom. The defaults below
# are conservative generic starting values, not a VRAM-fit promise.
MODEL_ROOT="$HOME/Models"
PRISM_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/prism-llama"
# Optional exact paths override discovery:
SERVER_BIN=""
BENCH_BIN=""
HOST=127.0.0.1
PORT=8080
CTX=4096
NGL=99
FLASH=on
BATCH=512
UBATCH=128
PARALLEL=1
CACHE_K=f16
CACHE_V=f16
LORA_ENABLED=off
LORA_PATH=""
LORA_SCALE=2

# Model/runtime capabilities still require a compatible custom backend.
VISION=off
# Empty MMPROJ_PATH selects --mmproj-auto (embedded/projector-adjacent) when the
# backend advertises it; set a path to force the explicit --mmproj FILE argument.
MMPROJ_PATH=""
MTP=off
# draft-mtp is the 3.0 default and maps to --spec-type draft-mtp. The value must
# be one advertised by the backend's --spec-type list; legacy "mtp" is still
# accepted only when the backend advertises it.
MTP_MODE=draft-mtp
MTP_DRAFT_MAX=3
# Modern default. Use --draft-max only when supported by an older custom build;
# a backend that marks the configured flag as removed blocks startup.
MTP_DRAFT_FLAG=--spec-draft-n-max
STARTUP_TIMEOUT=180
